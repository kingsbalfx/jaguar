# Public application URL
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SOCIAL_TWITTER=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TELEGRAM=
NEXT_PUBLIC_SOCIAL_WHATSAPP=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"turn-user","credential":"turn-password"}]

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Korapay
KORAPAY_SECRET_KEY=
KORAPAY_WEBHOOK_SECRET=

# Gmail SMTP lifecycle email
# Enable 2-Step Verification on the Gmail account, then create an App Password.
# Do not use your normal Gmail password. Spaces in the App Password are accepted.
SMTP_SERVICE=gmail
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=KINGSBALFX Academy <your-account@gmail.com>

# Vercel cron authorization
CRON_SECRET=

# MT5 encryption
MT5_CREDENTIALS_SECRET=

# --- Bot API (used by /admin/accounts, /admin/signals, signal delivery) ---
# BOT_API_URL: public URL of the bot's Flask API (ICT_Trading_Bot).
BOT_API_URL=
# BOT_API_INTERNAL: optional internal/VPS address, preferred when both are set.
BOT_API_INTERNAL=
# Token the web sends to the bot API (must match the bot's BOT_API_TOKEN or BOT_SIGNAL_SECRET).
BOT_API_TOKEN=
# Token the bot uses when POSTing signals to /api/bot/signals (matches ADMIN_API_KEY or BOT_API_TOKEN).
BOT_SIGNAL_SECRET=
# Token for /api/admin/bot-control (bot API key authentication).
ADMIN_API_KEY=
# How long the web waits for the bot API before falling back to Supabase data.
BOT_API_TIMEOUT_MS=8000
# Default signal audience when the bot does not send targetPlans.
BOT_SIGNAL_TARGET_PLANS=premium,vip,pro,lifetime
# Treat a paid profile role/bot_tier as signal access even without an active subscription row.
BOT_SIGNAL_ROLE_FALLBACK=true
# Use the plan default quota when a paid profile has bot_max_signals_per_day = 0.
BOT_SIGNAL_QUOTA_FALLBACK=true
# Include admins in the signal audience.
BOT_SIGNAL_INCLUDE_ADMIN=false
